<launch>

  <master auto="start"/>
  <arg name="wheel_radius" default="0.165"/>
  <arg name="wheel_base" default="0.525"/>
  <arg name="counts_per_rev" default="64000"/>
  <arg name="port" default="/dev/ttyACM0"/>
  <arg name="baud" default="921600"/>
  <arg name="timeout" default="0.05"/>

  <node name="serial_comm" pkg="canusb" type="serial_comm.py" output="screen">
    <param name="wheel_radius" value="$(arg wheel_radius)"/>
    <param name="wheel_base" value="$(arg wheel_base)"/>
    <param name="counts_per_rev" value="$(arg counts_per_rev)"/>
    <param name="port" value="$(arg port)"/>
    <param name="baud" value="$(arg baud)"/>
    <param name="timeout" value="$(arg timeout)"/>

  </node>
</launch>
